  "existing_scene_usda": "#usda 1.0\n(\n    defaultPrim = \"World\"\n    upAxis = \"Y\"\n    metersPerUnit = 1\n)\n\ndef Xform \"World\"\n{\n    def DomeLight \"StormAmbient\"\n    {\n        color3f inputs:color = (0.28, 0.36, 0.46)\n        float inputs:intensity = 0.45\n    }\n\n    def DistantLight \"StormKeyLight\"\n    {\n        color3f inputs:color = (0.86, 0.80, 0.72)\n        float inputs:intensity = 1.65\n        float angle = 0.53\n        float3 xformOp:rotateXYZ = (-35, -25, 0)\n        uniform token[] xformOpOrder = [\"xformOp:rotateXYZ\"]\n    }\n\n    def Xform \"Bridge\"\n    {\n        double3 xformOp:translate = (0, 0, 0)\n        uniform token[] xformOpOrder = [\"xformOp:translate\"]\n\n        def Cube \"Deck\"\n        {\n            float size = 1\n            double3 xformOp:translate = (0, -0.12, 0)\n            double3 xformOp:scale = (7.0, 0.24, 24.0)\n            uniform token[] xformOpOrder = [\"xformOp:translate\", \"xformOp:scale\"]\n            color3f[] primvars:displayColor = [(0.22, 0.25, 0.28)] (\n                interpolation = \"constant\"\n            )\n        }\n\n        def Cube \"LeftRail\"\n        {\n            float size = 1\n            double3 xformOp:translate = (-3.3, 0.55, 0)\n            double3 xformOp:scale = (0.16, 0.55, 24.0)\n            uniform token[] xformOpOrder = [\"xformOp:translate\", \"xformOp:scale\"]\n            color3f[] primvars:displayColor = [(0.68, 0.55, 0.26)] (\n                interpolation = \"constant\"\n            )\n        }\n\n        def Cube \"RightRail\"\n        {\n            float size = 1\n            double3 xformOp:translate = (3.3, 0.55, 0)\n            double3 xformOp:scale = (0.16, 0.55, 24.0)\n            uniform token[] xformOpOrder = [\"xformOp:translate\", \"xformOp:scale\"]\n            color3f[] primvars:displayColor = [(0.68, 0.55, 0.26)] (\n                interpolation = \"constant\"\n            )\n        }\n    }\n\n    def Xform \"DowntownTower\" (\n        customData = {\n            string asset_id = \"environment.downtown_tower\"\n            string world_state_role = \"object\"\n            string forward_axis = \"-Z\"\n        }\n        references = @../../assets/usdc_assets/environments/downtown_art_deco_tower.usdc@</root>\n    )\n    {\n        double3 xformOp:translate = (0.000, 0.000, -24.000)\n        float3 xformOp:rotateXYZ = (0.00, -180.00, 0.00)\n        double3 xformOp:scale = (0.250, 0.250, 0.250)\n        uniform token[] xformOpOrder = [\"xformOp:translate\", \"xformOp:rotateXYZ\", \"xformOp:scale\"]\n    }\n\n    def Xform \"WestBrownstones\" (\n        customData = {\n            string asset_id = \"environment.residential_neighborhood\"\n            string world_state_role = \"object\"\n            string forward_axis = \"-Z\"\n        }\n        references = @../../assets/usdc_assets/environments/residential_neighborhood.usdc@</root>\n    )\n    {\n        double3 xformOp:translate = (-11.500, 0.000, -2.000)\n        float3 xformOp:rotateXYZ = (0.00, -90.00, 0.00)\n        double3 xformOp:scale = (0.250, 0.250, 0.250)\n        uniform token[] xformOpOrder = [\"xformOp:translate\", \"xformOp:rotateXYZ\", \"xformOp:scale\"]\n    }\n\n    def Xform \"EastBrownstones\" (\n        customData = {\n            string asset_id = \"environment.residential_neighborhood\"\n            string world_state_role = \"object\"\n            string forward_axis = \"-Z\"\n        }\n        references = @../../assets/usdc_assets/environments/residential_neighborhood.usdc@</root>\n    )\n    {\n        double3 xformOp:translate = (11.500, 0.000, -2.000)\n        float3 xformOp:rotateXYZ = (0.00, -270.00, 0.00)\n        double3 xformOp:scale = (0.250, 0.250, 0.250)\n        uniform token[] xformOpOrder = [\"xformOp:translate\", \"xformOp:rotateXYZ\", \"xformOp:scale\"]\n    }\n\n    def Xform \"Car\" (\n        customData = {\n            string asset_id = \"vehicle.mustang\"\n            string world_state_role = \"