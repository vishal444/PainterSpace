            328: (2.503, 0.01, 5.747),
            329: (2.503, 0.01, 5.747),
        }
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]

        def SkelAnimation "BakedAnim" (
            prepend references = @anim_human_2.usda@
        )
        {
        }

        over "Armature"
        {
            over "Armature"
            {
                rel skel:animationSource = </World/Girl/BakedAnim>
            }
        }
    }
}

