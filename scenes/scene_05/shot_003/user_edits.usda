#usda 1.0
(
    doc = "PainterSpace manual user edits layer"
)

over "World"
{
    over "DowntownArtDecoTower" (
        active = false
    )
    {
        token visibility = "invisible"
    }

    def Xform "CitySquare" (
        customData = {
            string asset_id = "buildings.city_square"
            string forward_axis = "-Z"
            string world_state_role = "object"
        }
        prepend references = @../../../assets/usdc_assets/buildings/city_square.usdc@
    )
    {
        float3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

