        double3 xformOp:translate = (0, 0, -15.058244705200195)
    }

    def Xform "Tree" (
        active = false
        customData = {
            string asset_id = "prop.tree"
        }
    )
    {
        token visibility = "invisible"
        float3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-2.834990978240967, 0, 0.4431943893432617)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        def Cylinder "Trunk"
        {
            uniform token axis = "Y"
            double height = 1.8
            color3f[] primvars:displayColor = [(0.42, 0.28, 0.18)] (
                interpolation = "constant"
            )
            double radius = 0.22
            double3 xformOp:translate = (0, 0.9, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cone "Canopy"
        {
            uniform token axis = "Y"
            double height = 2.8
            color3f[] primvars:displayColor = [(0.24, 0.52, 0.3)] (
                interpolation = "constant"
            )
            double radius = 1.25
            double3 xformOp:translate = (0, 2.8, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def "CameraRig"
    {
        def Xform "Rig_01" (
            customData = {
                int schemaVersion = 1
            }
        )
        {
            custom token ps:aim_mode = "look_at"
            custom float3 ps:aim_offset = (-1.55625, 0.34101593, 0)
            custom float3 ps:aim_point = (0, 1.6433076, 6.0389276)
            custom float ps:aim_smoothing = 0.2
            custom token ps:aspect_ratio = "16:9"
            custom token ps:ease = "ease_in_out"
            custom float ps:focal_end = 12
            custom float ps:focal_start = 12
            custom float ps:path_end_s = 2
            custom float ps:path_start_s = 0
            custom token ps:sensor_preset = "16_9"
            custom token ps:shot_size = "medium"

            def BasisCurves "PositionPath"
            {
                uniform token basis = "catmullRom"
                int[] curveVertexCounts = [2]
                point3f[] points = [(0, 2.2, 10), (0, 2.2, 10)]
                uniform token type = "cubic"
            }
        }
    }

