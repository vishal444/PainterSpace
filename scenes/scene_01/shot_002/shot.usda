#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 96
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @../scene.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "World"
{
    over "Car"
    {
        float3 xformOp:rotateXYZ.timeSamples = {
            0: (0, 0, 0),
            48: (0, -12, 0),
            96: (0, -2, 0),
        }
        double3 xformOp:translate.timeSamples = {
            0: (1.4, 0, 11),
            48: (0.6, 0, 5),
            96: (0.1, 0, -0.2),
        }
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Xform "Hero" (
        customData = {
            string asset_id = "character.human.poseable"
            string forward_axis = "+Z"
        }
        references = @../../../assets/usdc_assets/humans/human.usdc@</root>
    )
    {
        float xformOp:rotateY = 180
        double3 xformOp:translate.timeSamples = {
            0: (-1.6, 0, 2.5),
            48: (-1.6, 0, -0.2999999999999998),
            96: (-1.6, 0, -0.2999999999999998),
        }
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]

        over SkelRoot "Armature"
        {
            float3 xformOp:rotateXYZ.timeSamples = {
                1: (0, 0, 0),
            }

            over "Armature"
            {
                rel skel:animationSource = </World/Hero/BakedAnim>
            }
        }

        over Xform "Camera"
        {
            token visibility = "invisible"
        }

        over Xform "Cube"
        {
            token visibility = "invisible"
        }

        over Xform "Light"
        {
            token visibility = "invisible"
        }

        over DomeLight "env_light" (
            active = false
        )
        {
        }

        def SkelAnimation "BakedAnim" (
            prepend references = @anim_Hero.usda@
        )
        {
        }
    }

    def Camera "ShotCam"
    {
        float2 clippingRange = (0.1, 1000)
        float focalLength = 32
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float3 xformOp:rotateXYZ.timeSamples = {
            0: (-10, -14, 0),
            96: (-8, -10, 0),
        }
        double3 xformOp:translate.timeSamples = {
            0: (-2.8, 2, 7.5),
            96: (-2.5, 1.8, 4.2),
        }
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

