#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def DomeLight "StormAmbient"
    {
        color3f inputs:color = (0.28, 0.36, 0.46)
        float inputs:intensity = 0.45
    }

    def DistantLight "StormKeyLight"
    {
        color3f inputs:color = (0.86, 0.80, 0.72)
        float inputs:intensity = 1.65
        float angle = 0.53
        float3 xformOp:rotateXYZ = (-35, -25, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Xform "Bridge"
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Deck"
        {
            float size = 1
            double3 xformOp:translate = (0, -0.12, 0)
            double3 xformOp:scale = (7.0, 0.24, 24.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.22, 0.25, 0.28)] (
                interpolation = "constant"
            )
        }

        def Cube "LeftRail"
        {
            float size = 1
            double3 xformOp:translate = (-3.3, 0.55, 0)
            double3 xformOp:scale = (0.16, 0.55, 24.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.68, 0.55, 0.26)] (
                interpolation = "constant"
            )
        }

        def Cube "RightRail"
        {
            float size = 1
            double3 xformOp:translate = (3.3, 0.55, 0)
            double3 xformOp:scale = (0.16, 0.55, 24.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.68, 0.55, 0.26)] (
                interpolation = "constant"
            )
        }
    }

    def Xform "DowntownTower" (
        customData = {
            string asset_id = "environment.downtown_tower"
            string world_state_role = "object"
            string forward_axis = "-Z"
        }
        references = @../../assets/usdc_assets/environments/downtown_art_deco_tower.usdc@</root>
    )
    {
        double3 xformOp:translate = (0.000, 0.000, -24.000)
        float3 xformOp:rotateXYZ = (0.00, -180.00, 0.00)
        double3 xformOp:scale = (0.250, 0.250, 0.250)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Xform "WestBrownstones" (
        customData = {
            string asset_id = "environment.residential_neighborhood"
            string world_state_role = "object"
            string forward_axis = "-Z"
        }
        references = @../../assets/usdc_assets/environments/residential_neighborhood.usdc@</root>
    )
    {
        double3 xformOp:translate = (-11.500, 0.000, -2.000)
        float3 xformOp:rotateXYZ = (0.00, -90.00, 0.00)
        double3 xformOp:scale = (0.250, 0.250, 0.250)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Xform "EastBrownstones" (
        customData = {
            string asset_id = "environment.residential_neighborhood"
            string world_state_role = "object"
            string forward_axis = "-Z"
        }
        references = @../../assets/usdc_assets/environments/residential_neighborhood.usdc@</root>
    )
    {
        double3 xformOp:translate = (11.500, 0.000, -2.000)
        float3 xformOp:rotateXYZ = (0.00, -270.00, 0.00)
        double3 xformOp:scale = (0.250, 0.250, 0.250)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Xform "Car" (
        customData = {
            string asset_id = "vehicle.mustang"
            string world_state_role = "object"
            string forward_axis = "-Z"
        }
    )
    {
        double3 xformOp:translate = (1.400, 0.000, 1.200)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Body"
        {
            float size = 1
            double3 xformOp:translate = (0.000, 0.580, 0.000)
            double3 xformOp:scale = (1.850, 0.650, 3.800)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.72, 0.14, 0.12)] (
                interpolation = "constant"
            )
        }

        def Cube "Cabin"
        {
            float size = 1
            double3 xformOp:translate = (0.000, 1.150, -0.200)
            double3 xformOp:scale = (1.550, 0.520, 2.000)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.16, 0.25, 0.32)] (
                interpolation = "constant"
            )
        }
    }

    # Named regions for the world state record (tools/world_state.py).
    # Invisible guide boxes: never rendered, only measured.
    def Scope "Zones"
    {
        def Cube "lane_west" (
            customData = {
                string description = "Southbound lane of the bridge roadway, between the west rail and the centre line"
            }
        )
        {
            float size = 1
            uniform token purpose = "guide"
            token visibility = "invisible"
            double3 xformOp:translate = (-1.61, 0.005, 0)
            double3 xformOp:scale = (3.22, 0.01, 24.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "lane_east" (
            customData = {
                string description = "Northbound lane of the bridge roadway, between the centre line and the east rail"
            }
        )
        {
            float size = 1
            uniform token purpose = "guide"
            token visibility = "invisible"
            double3 xformOp:translate = (1.61, 0.005, 0)
            double3 xformOp:scale = (3.22, 0.01, 24.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}
