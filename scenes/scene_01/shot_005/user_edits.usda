#usda 1.0
(
    doc = "PainterSpace manual user edits layer"
)

over "World"
{
    over "Bridge"
    {
        double3 xformOp:translate = (0.8989071846008301, 0, -0.3586463928222656)
    }

    over "Car" (
        active = false
    )
    {
        token visibility = "invisible"
    }

    over "ShotCam"
    {
        token visibility = "invisible"
    }
}
