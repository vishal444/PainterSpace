        def SkelAnimation "BakedAnim" (
            prepend references = @anim_human_1.usda@
        )
        {
        }

        over "Armature"
        {
            over "Armature"
            {
                rel skel:animationSource = </World/Parkour_Runner/BakedAnim>
            }
        }
    }
}

