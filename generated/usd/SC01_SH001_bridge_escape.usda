#usda 1.0
(
    defaultPrim = "Shot"
    startTimeCode = 0
    endTimeCode = 120
    timeCodesPerSecond = 24
    framesPerSecond = 24
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "Shot"
{
    custom string application:shotId = "SC01_SH001"
    custom string application:formatVersion = "1.0"
    custom string application:source = "ShotSpec"

    def Xform "World"
    {
        def DomeLight "NightAmbient"
        {
            color3f inputs:color = (0.15, 0.22, 0.32)
            float inputs:intensity = 0.35
        }
        def DistantLight "MoonKey"
        {
            color3f inputs:color = (0.55, 0.68, 1.0)
            float inputs:intensity = 1.2
            float angle = 0.53
            float3 xformOp:rotateXYZ = (-35, -20, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def Xform "Assets"
        {
            def Xform "hero"
            {
                custom string application:logicalAsset = "character.hero"
                custom string application:assetId = "hero"
                custom string application:intent = "reach_the_car_before_the_bridge_collapses"
                custom string application:locomotionStyle = "sprint"
                custom string application:locomotionTarget = "car"
                custom string application:emotion = "fear"
                custom float application:performanceIntensity = 0.92
                custom float application:urgency = 0.96
                custom string application:gazeTarget = "car"
                double3 xformOp:translate.timeSamples = {
                    0: (-2.000, 0.000, -4.500),
                    0: (-2.000, 0.000, -4.500),
                    82: (0.232, 0.000, -0.260)
                }
                uniform token[] xformOpOrder = ["xformOp:translate"]
                def Cylinder "Torso"
                {
                    float height = 1.35
                    float radius = 0.30
                    double3 xformOp:translate = (0, 1.55, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                    color3f[] primvars:displayColor = [(0.18, 0.42, 0.82)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
                def Sphere "Head"
                {
                    float radius = 0.28
                    double3 xformOp:translate = (0, 2.42, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                    color3f[] primvars:displayColor = [(0.94, 0.68, 0.48)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
                def Cylinder "LeftLeg"
                {
                    float height = 1.1
                    float radius = 0.14
                    double3 xformOp:translate = (-0.38, 0.48, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                    color3f[] primvars:displayColor = [(0.18, 0.42, 0.82)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
                def Cylinder "RightLeg"
                {
                    float height = 1.1
                    float radius = 0.14
                    double3 xformOp:translate = (0.38, 0.48, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                    color3f[] primvars:displayColor = [(0.18, 0.42, 0.82)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
                def Cylinder "LeftArm"
                {
                    float height = 1.05
                    float radius = 0.11
                    double3 xformOp:translate = (-0.38, 1.65, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                    color3f[] primvars:displayColor = [(0.18, 0.42, 0.82)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
                def Cylinder "RightArm"
                {
                    float height = 1.05
                    float radius = 0.11
                    double3 xformOp:translate = (0.38, 1.65, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                    color3f[] primvars:displayColor = [(0.18, 0.42, 0.82)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
            }
            def Xform "car"
            {
                custom string application:logicalAsset = "vehicle.sedan"
                custom string application:assetId = "car"
                double3 xformOp:translate = (1.000, 0.000, 1.200)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                def Cube "Body"
                {
                    double3 xformOp:translate = (0, 0.58, 0)
                    double3 xformOp:scale = (1.45, 0.38, 0.72)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    color3f[] primvars:displayColor = [(0.72, 0.12, 0.10)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
                def Cube "Cabin"
                {
                    double3 xformOp:translate = (-0.18, 1.18, 0)
                    double3 xformOp:scale = (0.72, 0.27, 0.58)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    color3f[] primvars:displayColor = [(0.16, 0.25, 0.32)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
                def Cylinder "FrontLeftWheel"
                {
                    float height = 0.20
                    float radius = 0.34
                    double3 xformOp:translate = (0.92, 0.34, -0.74)
                    float3 xformOp:rotateXYZ = (90, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
                    color3f[] primvars:displayColor = [(0.035, 0.04, 0.05)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
                def Cylinder "FrontRightWheel"
                {
                    float height = 0.20
                    float radius = 0.34
                    double3 xformOp:translate = (0.92, 0.34, 0.74)
                    float3 xformOp:rotateXYZ = (90, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
                    color3f[] primvars:displayColor = [(0.035, 0.04, 0.05)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
                def Cylinder "RearLeftWheel"
                {
                    float height = 0.20
                    float radius = 0.34
                    double3 xformOp:translate = (-0.92, 0.34, -0.74)
                    float3 xformOp:rotateXYZ = (90, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
                    color3f[] primvars:displayColor = [(0.035, 0.04, 0.05)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
                def Cylinder "RearRightWheel"
                {
                    float height = 0.20
                    float radius = 0.34
                    double3 xformOp:translate = (-0.92, 0.34, 0.74)
                    float3 xformOp:rotateXYZ = (90, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
                    color3f[] primvars:displayColor = [(0.035, 0.04, 0.05)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
            }
            def Xform "bridge"
            {
                custom string application:logicalAsset = "environment.bridge"
                custom string application:assetId = "bridge"
                double3 xformOp:translate = (0.000, 0.000, 5.000)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                def Cube "BridgeDeck"
                {
                    double3 xformOp:translate = (0, 0.05, 0)
                    double3 xformOp:scale = (2.8, 0.12, 7.5)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    color3f[] primvars:displayColor = [(0.22, 0.25, 0.28)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
                def Cube "LeftRail"
                {
                    double3 xformOp:translate = (-2.58, 0.68, 0)
                    double3 xformOp:scale = (0.06, 0.25, 7.5)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    color3f[] primvars:displayColor = [(0.68, 0.55, 0.26)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
                def Cube "RightRail"
                {
                    double3 xformOp:translate = (2.58, 0.68, 0)
                    double3 xformOp:scale = (0.06, 0.25, 7.5)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    color3f[] primvars:displayColor = [(0.68, 0.55, 0.26)]
                    uniform token primvars:displayColor:interpolation = "constant"
                }
            }
        }

        def Xform "CameraRig"
        {
            custom string application:movement = "tracking_push_in"
            double3 xformOp:translate.timeSamples = {
                0: (6.500, 3.100, 11.000),
                120: (3.770, 1.798, 6.380)
            }
            float3 xformOp:rotateXYZ.timeSamples = {
                0: (-12, 31, 0),
                120: (-9, 31, 0)
            }
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            def Camera "RenderCamera"
            {
                float focalLength = 28
                float horizontalAperture = 36
                float verticalAperture = 20.25
                custom string application:target = "hero"
                custom string application:focusTarget = ""
            }
        }

        def Scope "Effects"
        {
            custom bool application:rain = true
            custom bool application:lightFlicker = false
            custom bool application:motionBlur = false
        }
    }
}
