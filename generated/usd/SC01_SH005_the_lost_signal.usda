#usda 1.0
(
    defaultPrim = "Shot"
    startTimeCode = 0
    endTimeCode = 168
    timeCodesPerSecond = 24
    framesPerSecond = 24
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "Shot"
{
    custom string application:shotId = "SC01_SH005"
    custom string application:formatVersion = "1.0"
    custom string application:source = "ShotSpec"

    def Xform "World"
    {
        def DomeLight "NightAmbient"
        {
            color3f inputs:color = (0.15, 0.22, 0.32)
            float inputs:intensity = 0.35
        }
        def DistantLight "MoonKey"
        {
            color3f inputs:color = (0.55, 0.68, 1.0)
            float inputs:intensity = 1.2
            float angle = 0.53
            float3 xformOp:rotateXYZ = (-35, -20, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def Xform "Assets"
        {
            def Xform "detective"
            {
                custom string application:logicalAsset = "character.hero"
                custom string application:assetId = "detective"
                custom string application:animationClip = "walk_cautiously_then_reach"
                double3 xformOp:translate.timeSamples = {
                    0: (0.000, 0.000, -1.200),
                    72: (0.000, 0.000, -1.200),
                    168: (0.000, 0.000, 0.000)
                }
                uniform token[] xformOpOrder = ["xformOp:translate"]
                def Cube "ProxyGeometry"
                {
                    token purpose = "guide"
                    float size = 1.8
                }
            }
            def Xform "subway_car"
            {
                custom string application:logicalAsset = "vehicle.car"
                custom string application:assetId = "subway_car"
                double3 xformOp:translate.timeSamples = {
                    0: (1.700, 0.000, 1.200),
                    132: (1.700, 0.000, 1.200),
                    168: (1.700, 0.000, -6.800)
                }
                uniform token[] xformOpOrder = ["xformOp:translate"]
                def Cube "ProxyGeometry"
                {
                    token purpose = "guide"
                    float size = 3.5
                }
            }
            def Xform "phone"
            {
                custom string application:logicalAsset = "prop.old_mobile_phone"
                custom string application:assetId = "phone"
                double3 xformOp:translate = (0.650, 0.800, 0.250)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                def Cube "ProxyGeometry"
                {
                    token purpose = "guide"
                    float size = 0.35
                }
            }
        }

        def Xform "CameraRig"
        {
            custom string application:movement = "slow_tracking_push_in"
            double3 xformOp:translate.timeSamples = {
                0: (6.500, 3.100, 11.000),
                168: (3.770, 1.798, 6.380)
            }
            float3 xformOp:rotateXYZ.timeSamples = {
                0: (-12, 31, 0),
                168: (-9, 31, 0)
            }
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            def Camera "RenderCamera"
            {
                float focalLength = 35
                float horizontalAperture = 36
                float verticalAperture = 20.25
                custom string application:target = "detective"
                custom string application:focusTarget = "detective.face"
            }
        }

        def Scope "Effects"
        {
            custom bool application:rain = true
            custom bool application:lightFlicker = true
            custom bool application:motionBlur = true
        }
    }
}
